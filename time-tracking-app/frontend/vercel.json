{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://digital-time-tracking-system-1.onrender.com/api/$1"
    },
    {
      "source": "/admin",
      "destination": "/admin-dashboard.html"
    },
    {
      "source": "/user",
      "destination": "/user-dashboard.html"
    },
    {
      "source": "/report",
      "destination": "/user-report.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/",
      "destination": "/login.html"
    }
  ],
  "redirects": [
    {
      "source": "/admin/login",
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/user/login",
      "destination": "/login",
      "permanent": false
    }
  ]
}
