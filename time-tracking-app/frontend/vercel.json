{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "https://digital-time-tracking-system-1.onrender.com/auth/$1"
    },
    {
      "source": "/admin/(.*)",
      "destination": "https://digital-time-tracking-system-1.onrender.com/admin/$1"
    },
    {
      "source": "/user/(.*)",
      "destination": "https://digital-time-tracking-system-1.onrender.com/user/$1"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/login", "dest": "/index.html" },
    { "src": "/register", "dest": "/register.html" },
    { "src": "/dashboard", "dest": "/user-dashboard.html" },
    { "src": "/administrator", "dest": "/admin-dashboard.html" },
    { "src": "/report", "dest": "/user-report.html" },
    { "src": "/(.*)", "status": 404, "dest": "/index.html" }
  ]
}
