{
  "version": 2,
  "public": false,
  "buildCommand": null,
  "devCommand": null,
  "installCommand": null,
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://digital-time-tracking-system-1.onrender.com/api/$1" },
    { "source": "/auth/(.*)", "destination": "https://digital-time-tracking-system-1.onrender.com/auth/$1" },
    { "source": "/user/(.*)", "destination": "https://digital-time-tracking-system-1.onrender.com/user/$1" },
    { "source": "/admin/(.*)", "destination": "https://digital-time-tracking-system-1.onrender.com/admin/$1" },
    { "source": "/(.*)", "destination": "/time-tracking-app/frontend/$1" }
  ],
  "cleanUrls": true
}
