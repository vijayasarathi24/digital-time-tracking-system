{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://digital-time-tracking-system-1.onrender.com/api/$1"
    },
    {
      "source": "/admin",
      "destination": "/time-tracking-app/frontend/admin-dashboard.html"
    },
    {
      "source": "/user",
      "destination": "/time-tracking-app/frontend/user-dashboard.html"
    },
    {
      "source": "/report",
      "destination": "/time-tracking-app/frontend/user-report.html"
    },
    {
      "source": "/login",
      "destination": "/time-tracking-app/frontend/login.html"
    },
    {
      "source": "/register",
      "destination": "/time-tracking-app/frontend/register.html"
    },
    {
      "source": "/(.*\\.js)",
      "destination": "/time-tracking-app/frontend/$1"
    },
    {
      "source": "/(.*\\.css)",
      "destination": "/time-tracking-app/frontend/$1"
    },
    {
      "source": "/(.*\\.png)",
      "destination": "/time-tracking-app/frontend/$1"
    },
    {
      "source": "/(.*\\.jpg)",
      "destination": "/time-tracking-app/frontend/$1"
    },
    {
      "source": "/",
      "destination": "/time-tracking-app/frontend/login.html"
    }
  ],
  "redirects": [
    {
      "source": "/admin/login",
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/user/login",
      "destination": "/login",
      "permanent": false
    }
  ]
}
